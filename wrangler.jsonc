{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "evolution-combatives-admin",
    "compatibility_date": "2026-08-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "@tanstack/react-start/server-entry",
    "workers_dev": true,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1
    },
    // Deploy-time placeholders only in committed config. Set real values via
    // `wrangler secret put` / CI deploy vars before any environment goes live.
    "unsafe": {
        "bindings": [
            { "name": "API_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
            { "name": "ADMIN_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } },
            { "name": "AUTH_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
        ]
    },
    "vars": {
        "VITE_SUPABASE_URL": "REPLACE_AT_DEPLOY",
        "VITE_SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
        "VITE_APP_URL": "REPLACE_AT_DEPLOY",
        "VITE_MOBILE_APP_SCHEME": "evolutioncombatives",
        "VITE_POSTHOG_KEY": "REPLACE_AT_DEPLOY",
        "VITE_POSTHOG_HOST": "REPLACE_AT_DEPLOY",
        "SUPABASE_URL": "REPLACE_AT_DEPLOY",
        "SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
        "APP_URL": "REPLACE_AT_DEPLOY",
        "ADMIN_URL": "REPLACE_AT_DEPLOY",
        "MOBILE_APP_SCHEME": "evolutioncombatives",
        "CLOUDFLARE_ACCOUNT_ID": "REPLACE_AT_DEPLOY",
        "CLOUDFLARE_CUSTOMER_SUBDOMAIN": "REPLACE_AT_DEPLOY",
        "STRIPE_PUBLISHABLE_KEY": "REPLACE_AT_DEPLOY",
        "STRIPE_BEGINNER_PRICE_ID": "REPLACE_AT_DEPLOY",
        "STRIPE_INTERMEDIATE_PRICE_ID": "REPLACE_AT_DEPLOY",
        "STRIPE_ADVANCED_PRICE_ID": "REPLACE_AT_DEPLOY"
    },
    "env": {
        "staging": {
            "name": "evolution-combatives-admin-staging",
            "workers_dev": true,
            "observability": {
                "enabled": true,
                "head_sampling_rate": 1
            },
            "unsafe": {
                "bindings": [
                    { "name": "API_RATE_LIMITER", "type": "ratelimit", "namespace_id": "2001", "simple": { "limit": 100, "period": 60 } },
                    { "name": "ADMIN_RATE_LIMITER", "type": "ratelimit", "namespace_id": "2002", "simple": { "limit": 100, "period": 60 } },
                    { "name": "AUTH_RATE_LIMITER", "type": "ratelimit", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } }
                ]
            },
            "vars": {
                "VITE_SUPABASE_URL": "REPLACE_AT_DEPLOY",
                "VITE_SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
                "VITE_APP_URL": "REPLACE_AT_DEPLOY",
                "VITE_MOBILE_APP_SCHEME": "evolutioncombatives",
                "VITE_POSTHOG_KEY": "REPLACE_AT_DEPLOY",
                "VITE_POSTHOG_HOST": "REPLACE_AT_DEPLOY",
                "SUPABASE_URL": "REPLACE_AT_DEPLOY",
                "SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
                "APP_URL": "REPLACE_AT_DEPLOY",
                "ADMIN_URL": "REPLACE_AT_DEPLOY",
                "MOBILE_APP_SCHEME": "evolutioncombatives",
                "CLOUDFLARE_ACCOUNT_ID": "REPLACE_AT_DEPLOY",
                "CLOUDFLARE_CUSTOMER_SUBDOMAIN": "REPLACE_AT_DEPLOY",
                "STRIPE_PUBLISHABLE_KEY": "REPLACE_AT_DEPLOY",
                "STRIPE_BEGINNER_PRICE_ID": "REPLACE_AT_DEPLOY",
                "STRIPE_INTERMEDIATE_PRICE_ID": "REPLACE_AT_DEPLOY",
                "STRIPE_ADVANCED_PRICE_ID": "REPLACE_AT_DEPLOY"
            }
        },
        "preview": {
            "name": "evolution-combatives-admin-preview",
            "workers_dev": true,
            "preview_urls": true,
            "observability": {
                "enabled": true,
                "head_sampling_rate": 1
            },
            "unsafe": {
                "bindings": [
                    { "name": "API_RATE_LIMITER", "type": "ratelimit", "namespace_id": "3001", "simple": { "limit": 100, "period": 60 } },
                    { "name": "ADMIN_RATE_LIMITER", "type": "ratelimit", "namespace_id": "3002", "simple": { "limit": 100, "period": 60 } },
                    { "name": "AUTH_RATE_LIMITER", "type": "ratelimit", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } }
                ]
            },
            "vars": {
                "VITE_SUPABASE_URL": "REPLACE_AT_DEPLOY",
                "VITE_SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
                "VITE_APP_URL": "REPLACE_AT_DEPLOY",
                "VITE_MOBILE_APP_SCHEME": "evolutioncombatives",
                "VITE_POSTHOG_KEY": "REPLACE_AT_DEPLOY",
                "VITE_POSTHOG_HOST": "REPLACE_AT_DEPLOY",
                "SUPABASE_URL": "REPLACE_AT_DEPLOY",
                "SUPABASE_ANON_KEY": "REPLACE_AT_DEPLOY",
                "APP_URL": "REPLACE_AT_DEPLOY",
                "ADMIN_URL": "REPLACE_AT_DEPLOY",
                "MOBILE_APP_SCHEME": "evolutioncombatives",
                "CLOUDFLARE_ACCOUNT_ID": "REPLACE_AT_DEPLOY",
                "CLOUDFLARE_CUSTOMER_SUBDOMAIN": "REPLACE_AT_DEPLOY",
                "STRIPE_PUBLISHABLE_KEY": "REPLACE_AT_DEPLOY",
                "STRIPE_BEGINNER_PRICE_ID": "REPLACE_AT_DEPLOY",
                "STRIPE_INTERMEDIATE_PRICE_ID": "REPLACE_AT_DEPLOY",
                "STRIPE_ADVANCED_PRICE_ID": "REPLACE_AT_DEPLOY"
            }
        }
    }
}
