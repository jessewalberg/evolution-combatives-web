                "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhrbmplenRzbHZiZW5tbGFxZnFhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjEyNTEyMDIsImV4cCI6MjA3NjgyNzIwMn0.AwOH_o7KqGML5qxDO_TBGmM3D28dvd5JFietLm3YkNs",
