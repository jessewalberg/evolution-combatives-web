// Single config for all Worker targets. The @cloudflare/vite-plugin flattens
// this into a single-env dist/server/wrangler.json at build time, based on the
// CLOUDFLARE_ENV env var:
//
//   CLOUDFLARE_ENV unset       → top-level block → evolution-combatives-admin (production)
//   CLOUDFLARE_ENV=staging     → env.staging     → evolution-combatives-admin-staging
//   CLOUDFLARE_ENV=preview     → env.preview     → evolution-combatives-admin-preview
//
// Package scripts:
//   pnpm deploy:production → production
//   pnpm deploy:staging    → staging
//
// Secrets attach to the Worker by NAME (set per env with `wrangler secret put
// <KEY>` / `wrangler secret put --env staging <KEY>`):
//   SUPABASE_SERVICE_ROLE_KEY
//   STRIPE_SECRET_KEY
//   STRIPE_WEBHOOK_SECRET
//   CLOUDFLARE_API_TOKEN            (Stream API token)
//   CLOUDFLARE_STREAM_SIGNING_KEY
//   CLOUDFLARE_STREAM_SIGNING_KEY_ID
//   CLOUDFLARE_STREAM_WEBHOOK_SECRET
//
// Per Wrangler v4 env inheritance, `account_id`, `compatibility_date`,
// `compatibility_flags`, `main`, and `workers_dev` flow down. `vars` and
// `observability` do NOT inherit and must be repeated per env block.
//
// With this compatibility date + nodejs_compat, Workers populates
// `process.env` from vars/secrets, so server code can keep reading
// `process.env.X` at request time.
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "evolution-combatives-admin",
    // Jesse's personal Cloudflare account (same as howverydareyou). If the
    // Evolution Combatives Stream account is a different CF account, the
    // Worker still lives here — Stream is reached via API token, not binding.
    "account_id": "6b13f76a2d42fd29437154c35fa8a0c9",
    "compatibility_date": "2026-08-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "@tanstack/react-start/server-entry",
    // Production has NO public route until the custom domain is attached at
    // cutover (workers_dev inherits, so staging/preview re-enable it).
    "workers_dev": false,
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1
    },
    // TODO(deploy): replace placeholder values before first production deploy.
    // VITE_* vars are injected by vite.config.ts `define` from this file at
    // build time (CLOUDFLARE_ENV selects the env block); the non-VITE_*
    // duplicates are read by server code at runtime.
    "unsafe": {
        "bindings": [
            { "name": "API_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
            { "name": "ADMIN_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } },
            { "name": "AUTH_RATE_LIMITER", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
        ]
    },
    "vars": {
        "VITE_SUPABASE_URL": "https://bxpxpkiubjbcmgsnfpvp.supabase.co",
        "VITE_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4cHhwa2l1YmpiY21nc25mcHZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTA2MDMwMDYsImV4cCI6MjA2NjE3OTAwNn0.pNu3sSNs33hMvJcJuOta_udnV-lXF3LxXJqpqqPxfYw",
        "VITE_APP_URL": "https://evolutioncombatives.com",
        "VITE_MOBILE_APP_SCHEME": "evolutioncombatives",
        "VITE_POSTHOG_KEY": "phc_HQY1191X359mG41VEpvieYN9qiSY3acZnopO2JZiYry",
        "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
        "SUPABASE_URL": "https://bxpxpkiubjbcmgsnfpvp.supabase.co",
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4cHhwa2l1YmpiY21nc25mcHZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTA2MDMwMDYsImV4cCI6MjA2NjE3OTAwNn0.pNu3sSNs33hMvJcJuOta_udnV-lXF3LxXJqpqqPxfYw",
        "APP_URL": "https://evolutioncombatives.com",
        "ADMIN_URL": "https://evolutioncombatives.com",
        "MOBILE_APP_SCHEME": "evolutioncombatives",
        "CLOUDFLARE_ACCOUNT_ID": "6b13f76a2d42fd29437154c35fa8a0c9",
