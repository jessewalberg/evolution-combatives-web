                "VITE_APP_URL": "https://evolution-combatives-admin-staging.jesse-6b1.workers.dev",
                "VITE_MOBILE_APP_SCHEME": "evolutioncombatives",
                "VITE_POSTHOG_KEY": "phc_FCJLRSEAiFD4j4mJwNC8Cp6vETZePn7A7pKeleO6qyD",
                "VITE_POSTHOG_HOST": "https://us.i.posthog.com",
                "SUPABASE_URL": "https://hknjeztslvbenmlaqfqa.supabase.co",
