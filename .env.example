# Evolution Combatives Admin - Environment Variables
#
# Split across two files (both gitignored):
#   .env.local  — client-side build vars (VITE_*), read by Vite at build/dev
#   .dev.vars   — server-side Worker vars/secrets for local dev (see
#                 .dev.vars.example); production/staging values live in
#                 wrangler.jsonc vars + `wrangler secret put`
#
# Secrets are managed in 1Password via secretkit (secrets.manifest.json).

# --- .env.local (client, VITE_*) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_URL=http://localhost:3000
VITE_MOBILE_APP_SCHEME=evolutioncombatives
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- E2E only (process env for Playwright) ---
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your_e2e_password
