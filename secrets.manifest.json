{
  "project": "evolution-combatives-admin",
  "stack": {
    "host": "cloudflare-workers",
    "framework": "tanstack-start",
    "backend": "supabase",
    "auth": "supabase-auth",
    "packageManager": "pnpm",
    "packageManagerField": "pnpm@11.7.0",
    "publicPrefix": "VITE_"
  },
  "vaults": {
    "app": "evolution-combatives-web-app",
    "ci": "evolution-combatives-web-ci"
  },
  "source": {
    "kind": "1password",
    "envFiles": [
      ".env.local",
      ".dev.vars"
    ]
  },
  "ignorePrefixes": [],
  "environments": [
    {
      "name": "dev",
      "sourceConfig": ".dev.vars",
      "branch": null,
      "wranglerEnv": null,
      "wranglerConfigs": null,
      "githubEnvironment": null
    },
    {
      "name": "preview",
      "sourceConfig": ".dev.vars",
      "branch": null,
      "wranglerEnv": "preview",
      "wranglerConfigs": [
        "wrangler.jsonc"
      ],
      "githubEnvironment": "preview"
    },
    {
      "name": "staging",
      "sourceConfig": ".dev.vars",
      "branch": null,
      "wranglerEnv": "staging",
      "wranglerConfigs": [
        "wrangler.jsonc"
      ],
      "githubEnvironment": null
    },
    {
      "name": "production",
      "sourceConfig": ".dev.vars",
      "branch": "main",
      "wranglerEnv": null,
      "wranglerConfigs": [
        "wrangler.jsonc"
      ],
      "githubEnvironment": "production"
    }
  ],
  "secrets": {
    "worker": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_STREAM_SIGNING_KEY",
      "CLOUDFLARE_STREAM_SIGNING_KEY_ID",
      "CLOUDFLARE_STREAM_WEBHOOK_SECRET"
    ],
    "ci": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "VITE_SUPABASE_URL",
      "VITE_SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "E2E_ADMIN_EMAIL",
      "E2E_ADMIN_PASSWORD"
    ]
  }
}
